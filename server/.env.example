# Purpose: Shows the server environment variables needed for local development.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/euarcp
PUBLIC_API_URL=http://localhost:5000
# Generate a unique random secret of at least 32 characters for bearer-token signing.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Replace the local URI above with your actual MongoDB connection string.
ADMIN_NAME=admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gmail.com
# Set a unique admin password of at least 8 characters.
ADMIN_PASSWORD=Admin@1234
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=
